# Copy to .env.local and fill in. Every value here is a PUBLIC client
# identifier — they ship inside the JavaScript bundle by design. Access is
# controlled by Firebase Auth settings and Firestore security rules (or
# Postgres Row-Level Security), never by keeping these hidden. Do not put a
# Supabase service_role key here; that one IS a secret and must never reach
# the browser.
#
# Leave these unset and the app runs entirely on localStorage (guest mode).

# --- Firebase (login + database) ---
# Firebase console -> Project settings -> Your apps -> Web app
# These four are all you need: Firebase Auth signs the user in and Cloud
# Firestore stores their board. Firestore has no keys of its own.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# --- Cloud backend (optional) ---
# 'firestore' (default) or 'supabase'. Unset, the app uses Supabase when the
# two variables below are both filled in, and Firestore otherwise.
VITE_CLOUD_BACKEND=

# --- Supabase Postgres (optional alternative storage) ---
# Only needed to store boards in Postgres instead of Firestore. Requires the
# schema in supabase/migrations/ and Third-Party Auth pointed at Firebase.
# Supabase dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
