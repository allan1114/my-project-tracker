# Copy to .env.local and fill in. Every value here is a PUBLIC client
# identifier — they ship inside the JavaScript bundle by design. Access is
# controlled by Firebase Auth settings and Postgres Row-Level Security, never
# by keeping these hidden. Do not put a Supabase service_role key here; that
# one IS a secret and must never reach the browser.
#
# Leave these unset and the app runs entirely on localStorage (guest mode).

# --- Firebase Auth (login) ---
# Firebase console -> Project settings -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# --- Supabase Postgres (storage) ---
# Supabase dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
